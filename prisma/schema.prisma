generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MERCHANT
  BUYER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store?
  orders Order[]
}

model Store {
  id          String   @id @default(cuid())
  storeName   String
  slug        String   @unique
  description String?
  location    String?
  phone       String?
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchantId String @unique
  merchant   User   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  merchantProducts MerchantProduct[]
  orders           Order[]
}

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  category        String
  brand           String
  description     String?
  wholesalePrice  Float    @default(0)
  suggestedRetail Float
  stockQuantity   Int      @default(0)
  imageUrl        String?
  isCustomMerchantProduct Boolean @default(false) // True niba ari stock y'umucuruzi ubwe
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchantProducts MerchantProduct[]
  orderItems       OrderItem[]
}

model MerchantProduct {
  id          String   @id @default(cuid())
  retailPrice Float
  isListed    Boolean  @default(true)
  createdAt   DateTime @default(now())

  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String
  deliveryAddress String
  totalAmount     Float
  netProfit       Float       @default(0)
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("MOMO")
  createdAt       DateTime    @default(now())

  buyerId String?
  buyer   User?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  items OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  quantity       Int
  retailPrice    Float
  wholesalePrice Float

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}