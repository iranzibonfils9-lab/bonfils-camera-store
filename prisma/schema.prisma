datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MERCHANT
  BUYER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  store  Store?
  orders Order[]
}

model Store {
  id          String   @id @default(uuid())
  storeName   String
  slug        String   @unique
  location    String?
  phone       String?
  description String?
  merchantId  String   @unique
  createdAt   DateTime @default(now())

  // Relationships
  merchant         User              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantProducts MerchantProduct[]
  orders           Order[]
}

model Product {
  id              String   @id @default(uuid())
  sku             String   @unique
  name            String
  category        String
  brand           String
  description     String?
  wholesalePrice  Float    // Price charged by BONFILS supplier
  suggestedRetail Float    // Suggested retail selling price
  stockQuantity   Int      @default(0)
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  merchantProducts MerchantProduct[]
  orderItems       OrderItem[]
}

model MerchantProduct {
  id          String   @id @default(uuid())
  storeId     String
  productId   String
  retailPrice Float    // Custom price set by the merchant
  isListed    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relationships
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  storeId         String
  totalRetail     Float
  totalWholesale  Float
  netProfit       Float       // Difference (Merchant profit)
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("MOMO")
  customerName    String
  customerPhone   String
  deliveryAddress String
  createdAt       DateTime    @default(now())

  // Relationships
  buyer User        @relation(fields: [buyerId], references: [id])
  store Store       @relation(fields: [storeId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  productId      String
  quantity       Int
  retailPrice    Float
  wholesalePrice Float

  // Relationships
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}