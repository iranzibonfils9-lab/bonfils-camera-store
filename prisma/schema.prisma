datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("BUYER") // ADMIN, MERCHANT, BUYER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store?
  orders           Order[]
  sourcingRequests ChinaSourcingRequest[]
}

model Store {
  id          String   @id @default(uuid())
  storeName   String
  slug        String   @unique
  location    String?
  phone       String?
  description String?
  merchantId  String   @unique
  createdAt   DateTime @default(now())

  merchant         User                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantProducts MerchantProduct[]
  orders           Order[]
  sourcingRequests ChinaSourcingRequest[]
}

model Product {
  id              String   @id @default(uuid())
  sku             String   @unique
  name            String
  category        String
  brand           String
  description     String?
  wholesalePrice  Float
  suggestedRetail Float
  stockQuantity   Int      @default(0)
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchantProducts MerchantProduct[]
  orderItems       OrderItem[]
}

model MerchantProduct {
  id          String   @id @default(uuid())
  storeId     String
  productId   String
  retailPrice Float
  isListed    Boolean  @default(true)
  createdAt   DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  storeId         String
  totalRetail     Float
  totalWholesale  Float
  netProfit       Float
  status          String      @default("PENDING")
  paymentMethod   String      @default("MOMO")
  customerName    String
  customerPhone   String
  deliveryAddress String
  createdAt       DateTime    @default(now())

  buyer User        @relation(fields: [buyerId], references: [id])
  store Store       @relation(fields: [storeId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  productId      String
  quantity       Int
  retailPrice    Float
  wholesalePrice Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model ChinaSourcingRequest {
  id            String   @id @default(uuid())
  userId        String
  storeId       String?
  productName   String
  category      String
  quantity      Int
  targetPrice   Float?
  notes         String?
  status        String   @default("SUBMITTED") // SUBMITTED, QUOTED, IN_TRANSIT, DELIVERED
  createdAt     DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])
}